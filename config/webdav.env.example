# WebDAV 云同步凭证 —— 复制为 config/webdav.env 后填写，该文件已被 .gitignore 忽略
#
# 谁在用：
#   scripts/import-today-to-blog.mjs（导入当天文章 + 云同步 + 发公众号草稿）
#   scripts/resume-publish.mjs       （断点续跑：跳过拉取直接推送再发草稿）
#   两支脚本都经 scripts/dav-creds.mjs 读取，不各自解析。
#
# 为什么单独抽出来：
#   Gitee 仓库是**公开**的。以前这两支脚本里写着 `const DAV_PASS = '...'`，
#   等于把站点 WebDAV 的 Basic 口令随源码公开。现改为运行时读取，源码只留键名。
#
# 取值优先级：环境变量 > 本文件 > 代码内默认值（仅 URL / 用户名有默认，口令没有默认）
#
#   Windows CMD :  set EWT_DAV_PASS=你的口令        （当前窗口内生效，且覆盖本文件）
#   PowerShell  :  $env:EWT_DAV_PASS="你的口令"
#   临时一次性   :  在命令前加变量，例如 PowerShell 里 $env:EWT_DAV_PASS="..." ; node scripts/...

# 1) WebDAV 根地址（默认 https://www.codehelp.com.cn/dav/，一般不用改）
EWT_DAV_URL=https://www.codehelp.com.cn/dav/

# 2) 用户名（= 服务端 /dav/<用户名>/ 的那个目录名，站点 URL 里本就有，不算秘密）
EWT_DAV_USER=sifujiang

# 3) 口令（**必填**）：服务端 nginx htpasswd 里该账号的口令。
#    留空 = 脚本启动即报错退出（不会静默跳过，也不会回退到任何内置默认值）。
EWT_DAV_PASS=
