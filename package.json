{
  "name": "easywebtab",
  "version": "1.0.0",
  "description": "简洁的个人网址导航页，支持分类管理、全文搜索、键盘快捷键、暗色模式，以及导入/导出为 Markdown 文件。",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node scripts/build-safe.cjs",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "typecheck": "node node_modules/vue-tsc/bin/vue-tsc.js -b",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node node_modules/eslint/bin/eslint.js . --fix",
    "gen:books": "node scripts/gen-books-manifest.cjs",
    "serve": "node scripts/serve-with-rewrites.cjs",
    "webdav-proxy": "node scripts/webdav-proxy-only.cjs",
    "fetch-meta-proxy": "node scripts/fetch-meta-only.cjs",
    "start": "npm run build && npm run serve",
    "test:countdown": "node --experimental-strip-types scripts/test-countdown-core.ts",
    "test:reminder": "node --experimental-strip-types scripts/test-reminder-core.ts",
    "test:habits": "node --experimental-strip-types scripts/test-habit-core.ts",
    "test:todo": "node --experimental-strip-types scripts/test-todo-core.ts",
    "test:health": "node --experimental-strip-types scripts/test-health-core.ts",
    "test:genealogy": "node --experimental-strip-types scripts/test-genealogy-core.ts",
    "test:naming": "node --experimental-strip-types scripts/test-naming-core.ts",
    "test:tombstone": "node --experimental-strip-types scripts/test-tombstone-core.ts",
    "test:ledger": "node --experimental-strip-types scripts/test-ledger-core.ts",
    "test:notes": "node --experimental-strip-types scripts/test-note-core.ts",
    "test:diary": "node --experimental-strip-types scripts/test-diary-core.ts",
    "test:paging": "node --experimental-strip-types scripts/test-panel-paging-core.ts",
    "test:note-markdown": "node --experimental-strip-types scripts/test-note-markdown.ts",
    "test:blog": "node --experimental-strip-types --experimental-loader ./scripts/resolve-extensionless.mjs scripts/test-blog-core.ts",
    "test:books": "node --experimental-strip-types scripts/test-books-core.ts",
    "test:menu": "node --experimental-strip-types scripts/test-workbench-menu-core.ts",
    "test:spotlight": "node --experimental-strip-types scripts/test-spotlight-core.ts",
    "test:snapshot": "node --experimental-strip-types scripts/test-snapshot-core.ts",
    "test:pomodoro": "node --experimental-strip-types scripts/test-pomodoro-core.ts",
    "test:business": "node --experimental-strip-types scripts/test-business-core.ts",
    "test:smart": "node --experimental-strip-types --experimental-loader ./scripts/resolve-extensionless.mjs scripts/test-smart-core.ts",
    "test:smart-settings": "node --experimental-strip-types scripts/test-smart-settings-core.ts",
    "test:loan-extra": "node --experimental-strip-types --experimental-loader ./scripts/resolve-extensionless.mjs scripts/test-loan-extra-core.ts",
    "test:toolbox": "node --experimental-strip-types scripts/test-toolbox-core.ts",
    "test:nav-guard": "node --experimental-strip-types scripts/test-nav-guard.ts",
    "test:nav-meta": "node --experimental-strip-types scripts/test-nav-meta.ts",
    "test:nav-storage": "node --experimental-strip-types scripts/test-nav-storage.ts",
    "test:nav": "npm run test:nav-guard && npm run test:nav-meta && npm run test:nav-storage && node --experimental-strip-types scripts/diag-nav-loss.ts",
    "test:xlsx": "node --experimental-strip-types scripts/test-xlsx-export.ts",
    "qa:student-ui": "node scripts/qa-student-ui.mjs",
    "test:student-menu": "node --experimental-strip-types --experimental-loader ./scripts/resolve-extensionless.mjs scripts/test-student-menu-core.ts",
    "test:student-habits": "node --experimental-strip-types --experimental-loader ./scripts/resolve-extensionless.mjs scripts/test-student-habits-core.ts",
    "test:student-homework": "node --experimental-strip-types --experimental-loader ./scripts/resolve-extensionless.mjs scripts/test-student-homework-core.ts",
    "test:student-reward": "node --experimental-strip-types --experimental-loader ./scripts/resolve-extensionless.mjs scripts/test-student-reward-core.ts",
    "test:student-plan": "node --experimental-strip-types --experimental-loader ./scripts/resolve-extensionless.mjs scripts/test-student-plan-core.ts",
    "test:student-reading": "node --experimental-strip-types --experimental-loader ./scripts/resolve-extensionless.mjs scripts/test-student-reading-core.ts",
    "test:student-review": "node --experimental-strip-types --experimental-loader ./scripts/resolve-extensionless.mjs scripts/test-student-review-core.ts",
    "test:student-mistakes": "node --experimental-strip-types --experimental-loader ./scripts/resolve-extensionless.mjs scripts/test-student-mistakes-core.ts",
    "test:student-timetable": "node --experimental-strip-types --experimental-loader ./scripts/resolve-extensionless.mjs scripts/test-student-timetable-core.ts",
    "test:student-timetable-import": "node --experimental-strip-types --experimental-loader ./scripts/resolve-extensionless.mjs scripts/test-student-timetable-import-core.ts",
    "test:student-exam": "node --experimental-strip-types --experimental-loader ./scripts/resolve-extensionless.mjs scripts/test-student-exam-core.ts",
    "test:student-stage": "node --experimental-strip-types --experimental-loader ./scripts/resolve-extensionless.mjs scripts/test-student-stage-core.ts",
    "test:student-achievement": "node --experimental-strip-types --experimental-loader ./scripts/resolve-extensionless.mjs scripts/test-student-achievement-core.ts",
    "test:student-parenttask": "node --experimental-strip-types --experimental-loader ./scripts/resolve-extensionless.mjs scripts/test-student-parenttask-core.ts",
    "test:student-goal": "node --experimental-strip-types --experimental-loader ./scripts/resolve-extensionless.mjs scripts/test-student-goal-core.ts",
    "test:student": "npm run test:student-menu && npm run test:student-habits && npm run test:student-homework && npm run test:student-reward && npm run test:student-plan && npm run test:student-reading && npm run test:student-review && npm run test:student-mistakes && npm run test:student-timetable && npm run test:student-timetable-import && npm run test:student-exam && npm run test:student-stage && npm run test:student-achievement && npm run test:student-parenttask && npm run test:student-goal"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@vueuse/core": "^14.2.1",
    "crypto-js": "^4.2.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.5",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.9.0",
    "markdown-it": "^14.1.1",
    "mermaid": "^12.0.0",
    "metascraper": "^5.56.2",
    "metascraper-description": "^5.56.2",
    "metascraper-title": "^5.56.2",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.7.76",
    "pinia": "^3.0.4",
    "playwright": "^1.62.1",
    "polygon-clipping": "^0.15.7",
    "qrcode": "^1.5.4",
    "turndown": "^7.2.4",
    "vue": "^3.5.30",
    "vue-echarts": "^8.3.0",
    "vue-router": "^5.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/crypto-js": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.5",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^15.15.0",
    "pm2": "^5.3.0",
    "serve": "^14.2.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.0",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/sifujiang/easy-web-tab.git"
  },
  "keywords": [
    "bookmarks",
    "navigation",
    "new-tab",
    "vue3",
    "typescript",
    "markdown",
    "网址导航"
  ],
  "license": "MIT"
}
